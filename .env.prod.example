PORT=3000
NODE_ENV=production
SUPABASE_URL=https://your-prod-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_prod_key_here
SUPABASE_SECRET_KEY=sb_secret_prod_key_here
