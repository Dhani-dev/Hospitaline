{
  "name": "hospitaline",
  "version": "1.0.0",
  "description": "Hospital management RESTful API with Fastify and Supabase",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:check:60": "node scripts/checkCoverage.js 60",
    "coverage:check:85": "node scripts/checkCoverage.js 85"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dhani-dev/Hospitaline.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Dhani-dev/Hospitaline/issues"
  },
  "homepage": "https://github.com/Dhani-dev/Hospitaline#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.4",
    "@rolldown/binding-linux-x64-gnu": "^1.2.4",
    "@rolldown/binding-linux-x64-musl": "^1.2.4"
  }
} 
